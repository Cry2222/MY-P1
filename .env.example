# MY-P1 configuration. Copy to .env and edit.
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# paper = simulated fills, no credentials needed, real market prices
# live  = real orders with real money (see the live section at the bottom)
MYP1_MODE=paper

# ---------------------------------------------------------------------------
# Market
# ---------------------------------------------------------------------------
MYP1_EXCHANGE=binance
MYP1_SYMBOL=BTC/USDT
MYP1_TIMEFRAME=1m
MYP1_POLL_SECONDS=20

# ---------------------------------------------------------------------------
# Strategy
# ---------------------------------------------------------------------------
MYP1_STRATEGY=ema_cross
MYP1_FAST_PERIOD=12
MYP1_SLOW_PERIOD=26
MYP1_LONG_ONLY=true

# ---------------------------------------------------------------------------
# Paper simulation
# ---------------------------------------------------------------------------
MYP1_STARTING_CASH=1000
MYP1_FEE_PCT=0.1
MYP1_SLIPPAGE_PCT=0.02

# ---------------------------------------------------------------------------
# Risk limits — the bot cannot run without these
# ---------------------------------------------------------------------------
# Largest notional value of any single position.
MYP1_MAX_POSITION_NOTIONAL=100
# Fraction of equity committed per entry (0.02 = 2%).
MYP1_RISK_FRACTION=0.02
# Realized loss in one UTC day that halts new entries. Exits still work.
MYP1_MAX_DAILY_LOSS=25
# Runaway-loop protection.
MYP1_MAX_ORDERS_PER_DAY=40
# Fill price drift from the signal price that trips the kill switch, percent.
MYP1_MAX_SLIPPAGE_PCT=0.5
# Skip orders smaller than this notional.
MYP1_MIN_ORDER_NOTIONAL=5

# ---------------------------------------------------------------------------
# Telegram — your control surface and remote kill switch
# ---------------------------------------------------------------------------
# Token from @BotFather. Your numeric id from @userinfobot.
MYP1_TELEGRAM_TOKEN=
MYP1_TELEGRAM_OWNER_ID=
MYP1_TELEGRAM_ENABLED=true

# ---------------------------------------------------------------------------
# Control API — what the mobile app talks to
# ---------------------------------------------------------------------------
# Off by default. Enabling it counts as a remote kill switch for live mode,
# the same as Telegram does.
MYP1_API_ENABLED=false

# Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 24 characters. This token can halt trading — treat it like a key.
MYP1_API_TOKEN=

# Loopback by default. Do NOT bind this to 0.0.0.0 on a public host: a bearer
# token is authentication, not a security boundary. Use Tailscale or an SSH
# tunnel to reach it from your phone — see docs/deployment.md.
MYP1_API_HOST=127.0.0.1
MYP1_API_PORT=8333

# Interactive OpenAPI docs at /api/docs. Useful locally, off in production.
MYP1_API_DOCS=false

# Only needed for the Expo web preview, which makes cross-origin requests.
# Leave empty for the phone app — native apps are not subject to CORS.
MYP1_API_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Storage and logging
# ---------------------------------------------------------------------------
MYP1_JOURNAL_PATH=data/myp1.sqlite3
MYP1_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LIVE TRADING
# ---------------------------------------------------------------------------
# All four must be set together or startup fails:
#   1. MYP1_MODE=live
#   2. MYP1_LIVE_CONFIRM set to the exact phrase below
#   3. API key and secret
#   4. a reachable kill switch — either the Telegram config above or
#      MYP1_API_ENABLED=true with a token
#
# On the exchange, create keys with trading enabled and WITHDRAWALS DISABLED,
# and IP-restrict them to the host running the bot.
#
# MYP1_LIVE_CONFIRM=i-understand-this-trades-real-money
# MYP1_API_KEY=
# MYP1_API_SECRET=
