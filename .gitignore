# Secrets — never commit these
.env
.env.*
!.env.example
*.key
*.pem

# Runtime state
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Acme workspace (Helix scratch area, per the suite convention)
workspace/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Mobile app
node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
*.tsbuildinfo

# Generated native projects. `expo prebuild` recreates these from app.json and
# the config plugins on every build, so committing them would mean two sources
# of truth for the same settings.
mobile/android/
mobile/ios/

# Signing material — never commit a keystore or its passwords.
*.keystore
*.jks
mobile/android/keystores/
